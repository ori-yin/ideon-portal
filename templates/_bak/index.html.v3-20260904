<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MCD AI · iDeon 工具中台</title>
<style>
/* ============================================================
 * Design Token (designv3.md 中性主版本)
 * ============================================================ */
:root{
  --bg:#f5f5f7;
  --card:rgba(255,255,255,.72);
  --card-solid:rgba(255,255,255,.88);
  --line:rgba(60,60,67,.10);
  --text:#1d1d1f;
  --secondary:#6e6e73;
  --muted:#86868b;
  --blue:#0a6ee8;
  --blue-soft:#eaf3ff;
  --green:#22a06b;
  --purple:#7b61d1;
  --red:#e6525c;
  --shadow:0 10px 28px rgba(28,43,65,.055);
  --shadow-soft:0 6px 18px rgba(28,43,65,.04);
  --shadow-float:0 18px 50px rgba(28,43,65,.12);
  --radius:20px;
  --brand-red:#DA291C;
  --brand-yellow:#FFC72C;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","PingFang SC","Microsoft YaHei",sans-serif;color:var(--text);background:var(--bg)}
a{color:inherit;text-decoration:none}
button{font-family:inherit;font-size:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}

/* ============================================================
 * Environment Light (designv3 §7)
 * ============================================================ */
body{
  background:
    radial-gradient(900px 500px at 52% -150px,rgba(216,230,255,.72),transparent 70%),
    radial-gradient(700px 500px at 95% 90%,rgba(235,239,255,.7),transparent 65%),
    var(--bg);
  min-height:100vh;
}

/* ============================================================
 * Layout
 * ============================================================ */
.app{display:flex;min-height:100vh}
.sidebar{
  position:fixed;left:0;top:0;bottom:0;width:224px;padding:28px 18px 22px;
  background:linear-gradient(180deg,rgba(255,255,255,.94),rgba(255,255,255,.82));
  backdrop-filter:blur(30px);-webkit-backdrop-filter:blur(30px);
  border-right:1px solid rgba(255,255,255,.9);
  display:flex;flex-direction:column;z-index:10;
}
.brand{display:flex;align-items:center;gap:12px;padding:4px 11px 36px}
.logo{
  width:46px;height:46px;border-radius:13px;
  background:linear-gradient(145deg,#FFFFFF,#F5F5F7);
  box-shadow:0 8px 18px rgba(60,111,220,.12),inset 0 1px 2px rgba(255,255,255,.9);
  display:grid;place-items:center;flex-shrink:0;
  border:1px solid rgba(255,255,255,.9);
}
.logo svg{width:32px;height:32px;display:block}
.brand strong{font-size:20px;letter-spacing:-.45px;font-weight:650;display:block}
.brand small{display:block;color:var(--secondary);font-size:12px;margin-top:2px}

nav{display:grid;gap:7px}
.nav{
  height:51px;border-radius:15px;display:flex;align-items:center;gap:14px;
  padding:0 16px;color:#566171;text-decoration:none;font-size:14px;
  transition:.2s;cursor:pointer;
}
.nav:hover{background:rgba(255,255,255,.68);color:#245fae}
.nav.active{
  color:#2368c5;font-weight:600;
  background:linear-gradient(90deg,rgba(234,242,255,.95),rgba(225,234,249,.68));
  box-shadow:0 7px 18px rgba(40,86,150,.06),inset 0 1px 0 rgba(255,255,255,.9);
}
.nav-icon{width:20px;text-align:center;font-size:19px;font-style:normal;flex-shrink:0}
.nav.disabled{cursor:not-allowed;opacity:.55}
.nav.disabled:hover{background:transparent;color:#566171}

.profile{margin-top:auto;display:flex;align-items:center;gap:11px;padding:15px 8px;border-top:1px solid rgba(60,60,67,.06)}
.avatar{
  width:42px;height:42px;border-radius:50%;
  display:grid;place-items:center;
  background:linear-gradient(145deg,#f7f8fa,#e6eaf0);color:#6d7682;font-size:19px;font-weight:600;
  border:1px solid rgba(255,255,255,.9);flex-shrink:0;
}
.profile b{font-size:14px;font-weight:600;display:block}
.profile small{display:block;color:var(--secondary);font-size:12px;margin-top:3px}
.profile .arrow{margin-left:auto;color:#8b929d;font-size:14px}

/* ============================================================
 * Main
 * ============================================================ */
main{margin-left:224px;width:calc(100% - 224px);padding:30px 38px 22px;max-width:1780px}

/* ============================================================
 * Topbar (best.html style)
 * ============================================================ */
.topbar{display:flex;align-items:flex-start;justify-content:space-between}
.greeting h1{margin:0;font-size:31px;letter-spacing:-1px;font-weight:650}
.greeting p{margin:9px 0 0;color:#707782;font-size:14px}
.actions{display:flex;align-items:center;gap:13px}
.llm,.round-btn{
  background:rgba(255,255,255,.58);border:1px solid rgba(255,255,255,.9);
  box-shadow:0 7px 20px rgba(31,47,69,.045);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
}
.llm{
  padding:13px 20px;border-radius:999px;font-size:14px;color:#3f4854;
  display:flex;align-items:center;
}
.llm::before{
  content:"";display:inline-block;width:9px;height:9px;border-radius:50%;
  background:#2db580;margin-right:9px;box-shadow:0 0 10px rgba(45,181,128,.45);
}
.round-btn{
  width:48px;height:48px;border-radius:50%;
  display:grid;place-items:center;color:#5f6874;font-size:19px;position:relative;
  transition:.2s;
}
.round-btn:hover{background:rgba(255,255,255,.85);color:#1d1d1f}
.notice::after{
  content:"";position:absolute;width:6px;height:6px;border-radius:50%;
  background:#ff5f57;right:12px;top:10px;
}

/* ============================================================
 * Card base
 * ============================================================ */
.card{
  background:linear-gradient(145deg,var(--card-solid),var(--card));
  border:1px solid rgba(255,255,255,.9);border-radius:var(--radius);box-shadow:var(--shadow);
}

/* ============================================================
 * Metric Grid (best.html)
 * ============================================================ */
.metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:34px;margin-bottom:32px}
.metric{min-height:160px;padding:22px}
.metric-title{display:flex;align-items:center;gap:14px;color:#3f4650;font-size:14px;font-weight:500}
.metric-icon{
  width:51px;height:51px;border-radius:15px;
  display:grid;place-items:center;font-size:25px;
  background:linear-gradient(145deg,#f6faff,#e7f0ff);color:#2976da;
  box-shadow:0 8px 20px rgba(48,104,195,.08);
}
.metric:nth-child(2) .metric-icon{background:linear-gradient(145deg,#fff6f5,#ffe8e5);color:#ec625b}
.metric:nth-child(3) .metric-icon{background:linear-gradient(145deg,#f5efff,#eae2ff);color:#7758cf}
.metric:nth-child(4) .metric-icon{background:linear-gradient(145deg,#f8f4ff,#eee6ff);color:#805ddd}
.metric:nth-child(5) .metric-icon{background:linear-gradient(145deg,#f5faff,#e5efff);color:#2e73d5}
.metric-value{font-size:32px;font-weight:650;letter-spacing:-1px;margin:12px 0 8px 65px;line-height:1}
.metric-note{font-size:12px;color:#7a828e;margin-left:65px}
.metric-note .up{color:var(--green)}
.metric-note .down{color:var(--red)}

/* ============================================================
 * Tool Grid — 严格按 best.html .quick 风格（居中卡片）
 * ============================================================ */
.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:14px}
.section-head h2{margin:0;font-size:20px;letter-spacing:-.3px;font-weight:600}
.section-head .sub{color:var(--muted);font-size:12.5px;margin-top:3px}

.quick-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.tool-card{
  background:rgba(248,250,253,.72);
  border:1px solid rgba(255,255,255,.9);
  border-radius:16px;
  padding:17px 8px;
  text-align:center;
  transition:.2s;
  display:flex;flex-direction:column;align-items:center;gap:7px;
}
.tool-card:hover{
  background:#fff;
  transform:translateY(-2px);
  box-shadow:0 9px 20px rgba(31,47,69,.05);
}
.tc-icon{
  font-size:23px;color:#2d73d2;
  display:grid;place-items:center;line-height:1;
}
.tc-title{font-size:14px;font-weight:600;letter-spacing:-.1px;line-height:1.2;margin-top:7px}
.tc-subtitle{color:#7c8591;font-size:11px;line-height:1.4;min-height:14px;margin-bottom:4px}

.status-pill{
  display:inline-flex;align-items:center;gap:4px;
  padding:2px 8px;border-radius:999px;font-size:10.5px;font-weight:600;
  background:rgba(60,60,67,.06);color:var(--muted);
}
.status-pill .dot{width:5px;height:5px;border-radius:50%;background:var(--muted)}
.status-pill.running{background:rgba(34,160,107,.13);color:var(--green)}
.status-pill.running .dot{background:var(--green);box-shadow:0 0 5px rgba(34,160,107,.55)}
.status-pill.failed{background:rgba(230,82,92,.13);color:var(--red)}
.status-pill.failed .dot{background:var(--red)}
.status-pill.maintenance{background:rgba(233,138,0,.13);color:#c97800}
.status-pill.maintenance .dot{background:#c97800}

.tc-actions{display:flex;align-items:center;gap:5px;margin-top:auto;padding-top:2px}
.btn-open{
  display:inline-flex;align-items:center;justify-content:center;
  padding:0 10px;height:24px;border-radius:7px;
  background:var(--blue);color:#fff;font-size:11.5px;font-weight:600;
  transition:.2s;
}
.btn-open:hover{background:#005fcc}
.btn-restart{
  width:24px;height:24px;border-radius:7px;
  background:rgba(255,255,255,.85);color:#5f6874;
  border:1px solid var(--line);
  display:inline-flex;align-items:center;justify-content:center;
  font-size:12px;transition:.2s;
}
.btn-restart:hover{background:#fff;color:var(--text)}
.btn-restart:disabled{color:var(--muted);cursor:not-allowed;background:transparent}

/* ============================================================
 * Dashboard Grid 3-col (best.html dashboard-grid)
 * ============================================================ */
.dashboard-grid{display:grid;grid-template-columns:1.4fr .85fr 1fr;gap:14px;margin-top:8px}
.panel{padding:23px;border-radius:var(--radius);min-width:0}
.panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
.panel-head h2{font-size:17px;margin:0;letter-spacing:-.2px;font-weight:600}
.panel-head .more{font-size:12px;color:#747d88;cursor:pointer}
.panel-head .more:hover{color:var(--blue)}

/* Activity (left col) */
.activity-list{display:flex;flex-direction:column}
.activity{
  display:flex;align-items:center;gap:11px;
  padding:12px 0;border-bottom:1px solid var(--line);
  font-size:13px;
}
.activity:last-child{border-bottom:0}
.activity-icon{
  width:31px;height:31px;border-radius:10px;flex-shrink:0;
  background:#eef7f6;display:grid;place-items:center;
  color:var(--green);font-size:14px;
}
.activity:nth-child(2n) .activity-icon{background:#f5efff;color:var(--purple)}
.activity:nth-child(3n) .activity-icon{background:#fff6f5;color:var(--red)}
.activity:nth-child(4n) .activity-icon{background:#eaf3ff;color:var(--blue)}
.activity-text{flex:1;color:var(--text);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.activity-time{color:#818995;font-size:12px;flex-shrink:0;margin-left:8px}
.activity-empty{color:var(--muted);font-size:12.5px;text-align:center;padding:24px 0}

/* Status row (middle col) - best.html .status-row */
.status-list{display:flex;flex-direction:column}
.status-row{
  display:flex;justify-content:space-between;align-items:center;
  padding:14px 0;border-bottom:1px solid var(--line);
  font-size:13px;
}
.status-row:last-child{border-bottom:0}
.status-row .label{color:var(--text)}
.status-row .value{display:flex;align-items:center;gap:6px;color:var(--secondary)}
.status-row .ok{color:var(--green)}
.status-row .ok::before{content:"●";font-size:9px;color:var(--green);margin-right:7px}
.status-row .fail{color:var(--red)}
.status-row .warn{color:#c97800}
.status-row .muted{color:var(--muted)}

/* Feedback (right col) - best.html .feedback 单条 */
.feedback{
  margin-top:0;padding:14px 15px;border-radius:16px;
  background:#f6f8fb;border:1px solid rgba(255,255,255,.9);
  display:flex;gap:11px;align-items:center;font-size:13px;
  margin-bottom:10px;
}
.feedback:last-child{margin-bottom:0}
.feedback .ficon{font-size:22px;color:var(--blue);flex-shrink:0}
.feedback b{display:block;font-weight:600;margin-bottom:2px;color:var(--text)}
.feedback small{color:#7c8591;font-size:12px;line-height:1.5;display:block}
.feedback:nth-child(2) .ficon{color:var(--purple)}
.feedback:nth-child(3) .ficon{color:var(--green)}

/* ============================================================
 * Toast
 * ============================================================ */
.toast-wrap{position:fixed;top:24px;right:24px;z-index:100;display:flex;flex-direction:column;gap:10px;pointer-events:none}
.toast{
  padding:12px 16px;border-radius:12px;
  background:rgba(29,29,31,.92);color:#fff;
  font-size:13px;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  box-shadow:var(--shadow-float);
  min-width:240px;max-width:360px;
  animation:toast-in .25s ease-out;
}
.toast.error{background:rgba(230,82,92,.95)}
.toast.success{background:rgba(34,160,107,.95)}
@keyframes toast-in{from{transform:translateY(-10px);opacity:0}to{transform:translateY(0);opacity:1}}

/* ============================================================
 * Footer
 * ============================================================ */
footer{text-align:center;color:#89909a;font-size:12px;padding:22px 0 0;margin-top:18px}

/* ============================================================
 * Responsive
 * ============================================================ */
@media(max-width:1200px){
  .metric-grid{grid-template-columns:repeat(3,1fr)}
  .dashboard-grid{grid-template-columns:1fr 1fr}
  .panel-feedback{grid-column:span 2}
}
@media(max-width:800px){
  .sidebar{width:72px;padding:20px 9px}
  .brand{padding:4px 7px 28px}
  .brand-text,.nav span,.profile-info,.arrow{display:none}
  .nav{justify-content:center;padding:0}
  .profile{justify-content:center;padding-left:0;padding-right:0}
  main{margin-left:72px;width:calc(100% - 72px);padding:22px 15px}
  .topbar{align-items:flex-start}
  .greeting h1{font-size:25px}
  .actions .round-btn:nth-child(3){display:none}
  .metric-grid{grid-template-columns:1fr 1fr}
  .dashboard-grid{grid-template-columns:1fr}
  .panel-feedback{grid-column:auto}
}
@media(max-width:480px){
  .tool-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="app">

  <!-- ========== SIDEBAR ========== -->
  <aside class="sidebar">
    <div class="brand">
      <div class="logo">
        <svg viewBox="-40.605 -59.125 351.91 354.75" xmlns="http://www.w3.org/2000/svg" aria-label="MCD AI">
          <path d="M194.5 16.8c23.3 0 42.2 98.3 42.2 219.7h34C270.7 105.8 236.4 0 194.4 0c-24 0-45.2 31.7-59.2 81.5C121.2 31.7 100 0 76.2 0 34.2 0 0 105.7 0 236.4h34C34 115 52.7 16.8 76 16.8s42.2 90.8 42.2 202.8H152c0-112 19-202.8 42.3-202.8" fill="#FFC72C"/>
        </svg>
      </div>
      <div class="brand-text"><strong>MCD AI</strong><small>内容中台</small></div>
    </div>

    <nav>
      <a class="nav active" href="/"><i class="nav-icon">⌂</i><span>首页</span></a>
      <a class="nav disabled" href="#" title="即将上线"><i class="nav-icon">✎</i><span>内容工坊</span></a>
      <a class="nav disabled" href="#" title="即将上线"><i class="nav-icon">⬡</i><span>内容诊断</span></a>
      <a class="nav disabled" href="#" title="即将上线"><i class="nav-icon">⌁</i><span>内容预测</span></a>
      <a class="nav disabled" href="#" title="即将上线"><i class="nav-icon">◷</i><span>历史洞察</span></a>
      <a class="nav disabled" href="#" title="即将上线"><i class="nav-icon">⇧</i><span>结果回流</span></a>
      <a class="nav disabled" href="#" title="即将上线"><i class="nav-icon">⚙</i><span>设置中心</span></a>
      <a class="nav" href="/changelog"><i class="nav-icon">◐</i><span>更新日志</span></a>
    </nav>

    <div class="profile">
      <div class="avatar">A</div>
      <div class="profile-info"><b>Admin</b><small>管理员</small></div>
      <span class="arrow">⌄</span>
    </div>
  </aside>

  <!-- ========== MAIN ========== -->
  <main>
    <!-- Topbar -->
    <div class="topbar">
      <div class="greeting"><h1>下午好，Admin 👋</h1><p>欢迎使用 iDeon 工具中台，按需启停服务，闲置自动回收</p></div>
      <div class="actions">
        <div class="llm">LLM 已连接</div>
        <button class="round-btn notice" title="通知">♧</button>
        <button class="round-btn" title="账号">A</button>
      </div>
    </div>

    <!-- ========== Metric Grid ========== -->
    <section class="metric-grid">
      <div class="metric card">
        <div class="metric-title"><div class="metric-icon">▦</div>工具总数</div>
        <div class="metric-value" id="m-total">{{ cards|length + 1 }}</div>
        <div class="metric-note">含 1 个常驻后台</div>
      </div>
      <div class="metric card">
        <div class="metric-title"><div class="metric-icon">●</div>在线运行</div>
        <div class="metric-value" id="m-running">0</div>
        <div class="metric-note"><span class="up" id="m-running-pct">—</span></div>
      </div>
      <div class="metric card">
        <div class="metric-title"><div class="metric-icon">↗</div>总访问次数</div>
        <div class="metric-value" id="m-total-opens">—</div>
        <div class="metric-note">自部署起累计</div>
      </div>
      <div class="metric card">
        <div class="metric-title"><div class="metric-icon">↻</div>闲置超时</div>
        <div class="metric-value" style="font-size:28px">{{ idle_timeout }}<span style="font-size:16px;color:var(--muted);font-weight:500;margin-left:4px">分钟</span></div>
        <div class="metric-note">空闲后自动停止</div>
      </div>
    </section>

    <!-- ========== Tool Quick Grid (白底 panel + best.html .quick 风格) ========== -->
    <section class="card panel" style="padding:23px;margin-bottom:32px">
      <div class="panel-head">
        <h2>工具入口</h2>
        <span class="more">点击「进入」启动并跳转</span>
      </div>
      <div class="quick-grid">
        {% for t in cards %}
        <div class="tool-card" data-key="{{ t.key }}" id="card-{{ t.key }}">
          <div class="tc-icon">
            {% if t.key == 'content-rank' %}▣
            {% elif t.key == 'reach-trend' %}↗
            {% elif t.key == 'copy-analyzer' %}✎
            {% elif t.key == 'ctr-predictor' %}⌁
            {% else %}▦{% endif %}
          </div>
          <b class="tc-title">{{ t.title }}</b>
          <small class="tc-subtitle">{{ t.subtitle }}</small>
          {% if t.status == 'running' %}<span class="status-pill running"><span class="dot"></span>运行中</span>
          {% elif t.status == 'failed' %}<span class="status-pill failed"><span class="dot"></span>启动失败</span>
          {% elif t.status == 'maintenance' %}<span class="status-pill maintenance"><span class="dot"></span>维护中</span>
          {% else %}<span class="status-pill"><span class="dot"></span>已停止</span>{% endif %}
          <div class="tc-actions">
            <a class="btn-open" href="/open/{{ t.key }}">进入</a>
            <button class="btn-restart"
                    title="{% if t.status == 'stopped' %}请先启动服务{% else %}重启服务{% endif %}"
                    {% if t.status == 'stopped' %}disabled{% endif %}
                    onclick="restartTool('{{ t.key }}', this)">↻</button>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- ========== Dashboard 3-col ========== -->
    <section class="dashboard-grid">
      <!-- 最近活动 -->
      <div class="panel card">
        <div class="panel-head">
          <h2>最近活动</h2>
          <span class="more" onclick="refreshActivity()">刷新</span>
        </div>
        <div class="activity-list" id="activity-list">
          <div class="activity-empty">加载中…</div>
        </div>
      </div>

      <!-- 系统状态 -->
      <div class="panel card">
        <div class="panel-head">
          <h2>系统状态</h2>
          <span class="more" id="sys-updated">—</span>
        </div>
        <div class="status-list">
          <div class="status-row"><span class="label">LLM 服务</span><span class="value ok">正常</span></div>
          <div class="status-row"><span class="label">路由服务</span><span class="value ok">正常</span></div>
          <div class="status-row"><span class="label">访问日志</span><span class="value ok">SQLite</span></div>
          <div class="status-row"><span class="label">闲置超时</span><span class="value muted">{{ idle_timeout }} 分钟</span></div>
          <div class="status-row"><span class="label">检查间隔</span><span class="value muted">60 秒</span></div>
          <div class="status-row"><span class="label">数据更新</span><span class="value muted" id="data-update">—</span></div>
        </div>
      </div>

      <!-- 使用提示（best.html .feedback 风格，单条堆叠） -->
      <div class="panel card panel-feedback">
        <div class="panel-head">
          <h2>使用提示</h2>
        </div>
        <div class="feedback">
          <div class="ficon">💡</div>
          <div><b>闲置自动回收</b><small>{{ idle_timeout }} 分钟无访问会自动停止服务</small></div>
        </div>
        <div class="feedback">
          <div class="ficon">⚙</div>
          <div><b>Library 常驻服务</b><small>Library 为后台常驻，路由页已隐藏</small></div>
        </div>
        <div class="feedback">
          <div class="ficon">↻</div>
          <div><b>异常恢复</b><small>启动失败时点击 ↻ 重启或查看服务日志</small></div>
        </div>
      </div>
    </section>

    <footer>© 2026 MCD AI · iDeon 工具中台</footer>
  </main>
</div>

<div class="toast-wrap" id="toast-wrap"></div>

<script>
function toast(msg, type){
  const wrap = document.getElementById('toast-wrap');
  const el = document.createElement('div');
  el.className = 'toast ' + (type === 'error' ? 'error' : type === 'success' ? 'success' : '');
  el.textContent = msg;
  wrap.appendChild(el);
  setTimeout(()=>{ el.style.opacity='0'; el.style.transform='translateY(-10px)'; el.style.transition='all .25s'; setTimeout(()=>el.remove(),260) }, 2400);
}

async function restartTool(key, btn){
  if(btn.disabled) return;
  btn.disabled = true;
  const orig = btn.textContent;
  btn.textContent = '…';
  try{
    const r = await fetch('/api/restart/' + key, {method:'POST'});
    if(!r.ok) throw new Error(await r.text() || 'restart failed');
    toast('已发送重启指令：' + key, 'success');
    setTimeout(()=>{ window.location.href = '/loading/' + key; }, 800);
  }catch(e){
    toast('重启失败：' + e.message, 'error');
    btn.disabled = false;
    btn.textContent = orig;
  }
}

async function refreshStatus(){
  try{
    const [s, st] = await Promise.all([
      fetch('/api/summary').then(r=>r.json()),
      fetch('/api/status').then(r=>r.json()),
    ]);
    document.getElementById('m-running').textContent = s.running_count;
    const pct = s.total_tools ? Math.round(s.running_count / s.total_tools * 100) : 0;
    document.getElementById('m-running-pct').textContent = pct + '% 在线率';
    document.getElementById('m-total-opens').textContent = s.total_opens.toLocaleString();
    for(const [k, v] of Object.entries(st)){
      const card = document.getElementById('card-' + k);
      if(!card) continue;
      const pill = card.querySelector('.status-pill');
      const cls = v.status;
      pill.className = 'status-pill ' + (cls === 'running' ? 'running' : cls === 'failed' ? 'failed' : cls === 'maintenance' ? 'maintenance' : '');
      pill.innerHTML = '<span class="dot"></span>' + (
        cls === 'running' ? '运行中' :
        cls === 'failed' ? '启动失败' :
        cls === 'maintenance' ? '维护中' : '已停止'
      );
      // 重启按钮：根据状态启用/禁用
      const rb = card.querySelector('.btn-restart');
      if(rb){
        if(cls === 'stopped' || cls === 'not_installed'){
          rb.disabled = true;
          rb.title = '请先启动服务';
        }else{
          rb.disabled = false;
          rb.title = '重启服务';
        }
      }
    }
    document.getElementById('sys-updated').textContent = '更新 ' + new Date().toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'});
    document.getElementById('data-update').textContent = new Date().toLocaleString('zh-CN',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'});
  }catch(e){console.warn(e)}
}

async function refreshActivity(){
  try{
    const r = await fetch('/api/recent?limit=8');
    if(!r.ok) return;
    const items = await r.json();
    const wrap = document.getElementById('activity-list');
    if(!items.length){ wrap.innerHTML = '<div class="activity-empty">暂无访问记录</div>'; return; }
    wrap.innerHTML = items.map(it=>{
      const icon = ({'content-rank':'▣','reach-trend':'↗','copy-analyzer':'✎','ctr-predictor':'⌁'})[it.tool_key] || '▦';
      return `<div class="activity">
        <div class="activity-icon">${icon}</div>
        <div class="activity-text">${escapeHtml(it.title || it.tool_key)}</div>
        <div class="activity-time">${escapeHtml(it.relative || '')}</div>
      </div>`;
    }).join('');
  }catch(e){
    document.getElementById('activity-list').innerHTML = '<div class="activity-empty">加载失败</div>';
  }
}

function escapeHtml(s){return (s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c])}

refreshStatus();
refreshActivity();
setInterval(refreshStatus, 5000);
</script>
</body>
</html>
