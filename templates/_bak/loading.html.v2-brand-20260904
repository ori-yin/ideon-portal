<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>正在启动…</title>
<style>
  html,body{height:100%;margin:0;}
  body{
    background:#F7F8FA;
    display:flex;align-items:center;justify-content:center;
    flex-direction:column;gap:16px;
    font-family:"PingFang SC","Microsoft YaHei",sans-serif;
  }
  img{width:160px;max-width:70vw;height:auto;}
  .txt{font-size:14px;color:#6B7280;letter-spacing:.5px;}
  .sub{font-size:12px;color:#9CA3AF;}
</style>
</head>
<body>
  <img src="data:image/gif;base64," alt="loading">
  <div class="txt">正在启动工具，请稍候…</div>
  <div class="sub" id="sub">首次启动约需 5~30 秒</div>
  <script>
  const target = '{{ target }}';
  let tried = 0;
  function probe() {
    fetch(target, {method:'GET', cache:'no-store'})
      .then(r => {
        // streamlit 常返回 200 或 307；nginx 反代可达即可视为就绪
        if (r.status === 200 || r.status === 301 || r.status === 302 || r.status === 307) {
          location.replace(target);
        } else {
          retry();
        }
      })
      .catch(() => retry());
  }
  function retry() {
    tried++;
    if (tried > 40) { location.replace(target); return; }
    setTimeout(probe, 800);
  }
  setTimeout(probe, 300);
  </script>
</body>
</html>
